---
import Layout from '../layouts/Layout.astro';
import { getAcademicProfile } from '../lib/openalex';
const { metrics } = await getAcademicProfile();
---
<Layout title="Accueil">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-4">Pr. [Votre Nom]</h1>
    <p class="text-xl text-gray-600 leading-relaxed">
      Enseignante-chercheuse spécialisée en <strong>Low-code platforms</strong> 
      et <strong>Green IT</strong>. Je travaille sur l'optimisation énergétique 
      du développement logiciel.
    </p>
  </section>

  <div class="grid grid-cols-3 gap-8 p-6 bg-gray-50 rounded-lg">
    <div class="text-center">
      <p class="text-3xl font-bold text-green-700">{metrics.totalWorks}</p>
      <p class="text-sm uppercase tracking-wide">Publications</p>
    </div>
    <div class="text-center border-x">
      <p class="text-3xl font-bold text-green-700">{metrics.totalCitations}</p>
      <p class="text-sm uppercase tracking-wide">Citations</p>
    </div>
    <div class="text-center">
      <p class="text-3xl font-bold text-green-700">{metrics.hIndex}</p>
      <p class="text-sm uppercase tracking-wide">H-index</p>
    </div>
  </div>
</Layout>