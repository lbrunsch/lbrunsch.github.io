<Layout title="Accueil">
  <div class="flex flex-col md:flex-row items-center gap-12 mb-20">
    <div class="flex-1">
      <span class="text-green-600 font-bold tracking-widest text-xs uppercase">Docteur en Informatique</span>
      <h1 class="text-5xl font-black text-slate-900 mt-2 mb-6">Chercheuse en Génie Logiciel</h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        ATER au sein du laboratoire LIUPPA et membre de l'équipe Génie Logiciel, je suis spécialisée en <em>Low Code</em> et en <em>Green Code</em>.
      </p>
      <div class="flex gap-4">
        <a href="/cv" class="bg-slate-900 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-800 transition-colors">Voir mon CV</a>
        <a href="mailto:lea.brunsch@univ-pau.fr" class="px-6 py-3 rounded-lg font-medium border border-slate-300 hover:bg-slate-50">Me contacter</a>
      </div>
    </div>
    <div class="w-48 h-48 bg-green-100 rounded-2xl rotate-3 flex items-center justify-center border-2 border-green-200 shadow-xl">
       <span class="text-6xl">🌱</span>
    </div>
  </div>

  <SocialLinks />
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    </div>
</Layout>