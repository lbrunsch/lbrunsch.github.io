const getTotalHours = (year: AcademicYear) => year.courses.reduce((sum, c) => sum + c.hoursETD, 0);
---
<Layout title="Enseignements">
  <main class="max-w-5xl mx-auto px-6">
    
    <div class="space-y-16">
      {teachingList.map((period) => (
        <section class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
          {/* Header de l'année */}
          <div class="bg-slate-50 border-b border-slate-200 p-6 flex flex-wrap justify-between items-center gap-4">
            <div>
              <h2 class="text-xl font-bold text-slate-800">{period.year}</h2>
              <p class="text-sm text-green-600 font-medium">{period.contractType}</p>
            </div>
            <div class="bg-white border border-slate-200 px-4 py-2 rounded-lg shadow-sm">
              <span class="text-xs uppercase tracking-wider text-slate-400 font-bold block">Total Annuel</span>
              <span class="text-2xl font-black text-slate-800">{getTotalHours(period)} h <small class="text-sm font-normal text-slate-400 italic">ETD</small></span>
            </div>
          </div>

          {/* Tableau des cours */}
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-50/50 text-slate-500 text-xs uppercase tracking-widest border-b border-slate-100">
                  <th class="px-6 py-4 font-semibold">Cours</th>
                  <th class="px-6 py-4 font-semibold">Public</th>
                  <th class="px-6 py-4 font-semibold">Lieu</th>
                  <th class="px-6 py-4 font-semibold">Rôle</th>
                  <th class="px-6 py-4 font-semibold text-right">Volume ETD</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {period.courses.map((c) => (
                  <tr class="hover:bg-slate-50 transition-colors group">
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-2">
                        <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-1.5 py-0.5 rounded">
                          {c.level}
                        </span>
                        <span class="font-bold text-slate-800 group-hover:text-blue-600 transition-colors">{c.title}</span>

                      </div>
                    </td>
                    <td class="px-6 py-4 text-slate-600 text-sm">{c.target}</td>
                    <td class="px-6 py-4 text-slate-600 text-sm">{c.location}</td>
                    <td class="px-6 py-4 text-slate-600 text-sm">{c.resp}</td>
                    <td class="px-6 py-4 text-right font-mono font-medium text-slate-700">{c.hoursETD} h</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>