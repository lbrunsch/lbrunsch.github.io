---
interface Props {
  title: string;
  year: number;
  venue: string;
  citations: number;
  doi: string;
}
const { title, year, venue, citations, doi } = Astro.props;
---
<div class="group p-6 bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-green-200 transition-all">
  <div class="flex justify-between items-start gap-4">
    <h3 class="font-semibold text-lg leading-tight group-hover:text-green-800">{title}</h3>
    <span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-mono">{year}</span>
  </div>
  <p class="text-slate-500 mt-2 text-sm italic">{venue}</p>
  <div class="mt-4 flex items-center gap-4 text-xs font-medium text-slate-400">
    <span class="flex items-center gap-1">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M5 13l4 4L19 7"/></svg>
      {citations} citations
    </span>
    <a href={doi} target="_blank" class="text-green-700 hover:underline">Consulter le DOI →</a>
  </div>
</div>