---
interface Props { title: string; }
const { title } = Astro.props;
---
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Chercheuse Green IT</title>
  </head>
  <body class="bg-white text-gray-900 max-w-4xl mx-auto px-6 py-12">
    <nav class="flex gap-6 mb-12 border-b pb-4">
      <a href="/" class="hover:text-green-600">Accueil</a>
      <a href="/publications" class="hover:text-green-600">Publications</a>
      <a href="/enseignements" class="hover:text-green-600">Enseignements</a>
      <a href="/outils" class="hover:text-green-600">Outils</a>
      <a href="/cv" class="hover:text-green-600">CV</a>
    </nav>
    <main><slot /></main>
  </body>
</html>