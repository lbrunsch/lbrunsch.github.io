---
const { title } = Astro.props;
import '../styles/global.css';
---
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <title>Léa Brunschwig | {title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans selection:bg-green-100">
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
      <nav class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-bold text-green-800 hover:text-green-600 transition-colors">Léa Brunschwig</a>
        <div class="flex gap-6 text-sm font-medium">
          <a href="/publications" class="hover:text-green-600">Publications</a>
          <a href="/enseignements" class="hover:text-green-600">Cours</a>
          <a href="/cv" class="hover:text-green-600">Parcours</a>
        </div>
      </nav>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-16 min-h-screen">
      <slot />
    </main>

    <footer class="border-t border-slate-200 py-12 text-center text-sm text-slate-500">
      <p>Site conçuavec Astro & OpenAlex • {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>